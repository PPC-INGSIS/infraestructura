SNIPPETS_TAG=b8f417ec45953fda6c7e24b0b585be75ef81794e

# Base de Permisos (los valores por defecto sirven para desarrollo local)
PERMISSIONS_DB_NAME=permissions
PERMISSIONS_DB_USER=permissions
PERMISSIONS_DB_PASSWORD=permissions

# Base de Snippets (los valores por defecto sirven para desarrollo local)
SNIPPETS_DB_NAME=snippets
