# Borde de Snippet Searcher: el único punto de entrada desde afuera.
# Es una plantilla: al arrancar, la imagen de nginx reemplaza DOMINIO por la variable de entorno
# del servicio (sale del GitHub Environment) y deja el resultado en /etc/nginx/conf.d/default.conf.
# Las variables propias de nginx ($host, $request_uri y demás) no se tocan.

# No anunciar la versión de nginx en el header Server ni en las páginas de error.
server_tokens off;

# Para el WebSocket: si el pedido trae Upgrade, se reenvía "Connection: upgrade"; si no, "close".
# Es la forma que recomienda la documentación de nginx (va acá porque map solo vale fuera de server).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# HTTP (80): solo el desafío de Let's Encrypt. Todo lo demás se redirige a HTTPS.
server {
    listen 80;
    server_name ${DOMINIO};

    # Desafío HTTP-01: certbot deja el archivo en el volumen certbot-www y Let's Encrypt lo pide
    # por acá. Tiene que ser por HTTP: es como se prueba el dominio antes de tener certificado.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${DOMINIO}$request_uri;
    }
}

# HTTPS (443): acá termina TLS. Hacia los servicios sigue HTTP plano, por la red del stack.
# El certificado lo consigue y lo renueva el servicio certbot (volumen letsencrypt).
server {
    listen 443 ssl;
    server_name ${DOMINIO};

    ssl_certificate     /etc/letsencrypt/live/${DOMINIO}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMINIO}/privkey.pem;

    # Actuator es la administración de Spring: desde afuera no se ve. Sin barra final, para que
    # también agarre /api/actuator a secas (el índice de endpoints). El healthcheck de Swarm corre
    # adentro de cada contenedor y no pasa por acá.
    location /api/actuator {
        return 404;
    }

    # La API: /api/... va a Snippets sin el prefijo (/api/snippets llega como /snippets).
    # La barra final de proxy_pass es la que saca el /api.
    location /api/ {
        proxy_pass http://snippets:8080/;
        proxy_set_header Host $host;
        # Cómo era el pedido afuera, para que Snippets arme sus URLs con https y /api.
        # proxy_set_header pisa lo que mande el cliente: un X-Forwarded-* falso no llega a Snippets.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /api;
    }

    # La ejecución interactiva: WebSocket entre el browser y Snippets (/api/snippets/{id}/execution).
    # Es regex para que valga solo en esta ruta: nginx prueba las regex antes de quedarse con el prefijo
    # /api/ de arriba, así que el resto de la API no cambia.
    location ~ ^/api/snippets/[^/]+/execution$ {
        # Con una location regex, proxy_pass no puede llevar ruta: el /api se saca con el rewrite
        rewrite ^/api(/.*)$ $1 break;
        proxy_pass http://snippets:8080;

        # Upgrade y Connection son headers de un solo salto: nginx no los reenvía si no se le pide,
        # y sin ellos Snippets ve un GET común y responde 400. El WebSocket necesita HTTP/1.1.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /api;

        # Por defecto nginx corta a los 60 s sin tráfico, lo mismo que PrintScript espera cada input
        # (printscript.interactive.input-timeout). Más largo, para que el que corte sea PrintScript y el
        # usuario vea su mensaje "No se recibió un input en 60 s" en vez de un corte sin explicación.
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Todo lo demás es la UI, servida por su propio nginx en el servicio ui.
    location / {
        proxy_pass http://ui:80;
        proxy_set_header Host $host;
    }
}
