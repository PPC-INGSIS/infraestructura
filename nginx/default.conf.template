# Borde de Snippet Searcher: el único punto de entrada desde afuera.
# Es una plantilla: al arrancar, la imagen de nginx reemplaza DOMINIO por la variable de entorno
# del servicio (sale del GitHub Environment) y deja el resultado en /etc/nginx/conf.d/default.conf.
# Las variables propias de nginx ($host, $request_uri y demás) no se tocan.

# HTTP (80): solo el desafío de Let's Encrypt. Todo lo demás se redirige a HTTPS.
server {
    listen 80;
    server_name ${DOMINIO};

    # Desafío HTTP-01: certbot deja el archivo en el volumen certbot-www y Let's Encrypt lo pide
    # por acá. Tiene que ser por HTTP: es como se prueba el dominio antes de tener certificado.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${DOMINIO}$request_uri;
    }
}

# HTTPS (443): acá termina TLS. Hacia los servicios sigue HTTP plano, por la red del stack.
# El certificado lo consigue y lo renueva el servicio certbot (volumen letsencrypt).
server {
    listen 443 ssl;
    server_name ${DOMINIO};

    ssl_certificate     /etc/letsencrypt/live/${DOMINIO}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMINIO}/privkey.pem;

    # La API: /api/... va a Snippets sin el prefijo (/api/snippets llega como /snippets).
    # La barra final de proxy_pass es la que saca el /api.
    location /api/ {
        proxy_pass http://snippets:8080/;
        proxy_set_header Host $host;
    }

    # Todo lo demás es la UI, servida por su propio nginx en el servicio ui.
    location / {
        proxy_pass http://ui:80;
        proxy_set_header Host $host;
    }
}
