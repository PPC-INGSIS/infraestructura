# Borde de Snippet Searcher: el único punto de entrada desde afuera.
# Es una plantilla: al arrancar, la imagen de nginx reemplaza DOMINIO por la variable de entorno
# del servicio (sale del GitHub Environment) y deja el resultado en /etc/nginx/conf.d/default.conf.
# Las variables propias de nginx ($host y demás) no se tocan.
# Por ahora solo HTTP en el 80. HTTPS (certbot y el 443) va en el PR siguiente.
server {
    listen 80;
    server_name ${DOMINIO};

    # Desafío de Let's Encrypt (HTTP-01): certbot deja un archivo en el volumen certbot-www y
    # Let's Encrypt lo pide por acá para comprobar que el dominio es nuestro. Va por HTTP (80).
    location /.well-known/acme-challenge/ {
            root /var/www/certbot;
    }

    # La API: /api/... va a Snippets sin el prefijo (/api/snippets llega como /snippets).
    # La barra final de proxy_pass es la que saca el /api.
    location /api/ {
        proxy_pass http://snippets:8080/;
        proxy_set_header Host $host;
    }

    # Todo lo demás, por ahora, 404. La UI va a ir acá más adelante.
    location / {
        return 404;
    }
}
